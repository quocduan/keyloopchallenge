<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ScenarioA" targetNamespace="https://keyloop.example/scenario-a" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="Process_Booking" name="Unified Service Scheduler - Appointment Booking" isExecutable="false">
    <bpmn:startEvent id="Start_Request" name="Appointment requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Submit" name="Submit vehicle, service, dealership and desired time">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Validate" name="Validate request and determine service duration">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Request valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FindTech" name="Find technician qualified for service at dealership">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckPair" name="Find technician and bay free for entire service duration">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PairAvailable" name="Both resources available?" default="Flow_Unavailable">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Available</bpmn:outgoing>
      <bpmn:outgoing>Flow_Unavailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reserve" name="Atomically reserve technician and service bay">
      <bpmn:incoming>Flow_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Reserved" name="Reservation succeeded?" default="Flow_Conflict">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Conflict</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Persist" name="Persist appointment with customer, vehicle, technician and bay">
      <bpmn:incoming>Flow_Reserved</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirm" name="Return confirmed appointment">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Confirmed" name="Appointment confirmed">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Invalid" name="Return validation errors">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Invalid" name="Request rejected">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Unavailable" name="Return unavailable; ask customer to choose another time">
      <bpmn:incoming>Flow_Unavailable</bpmn:incoming>
      <bpmn:incoming>Flow_Conflict</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Unavailable" name="Not confirmed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Request" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Yes" sourceRef="Gateway_Valid" targetRef="Task_FindTech" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="No" sourceRef="Gateway_Valid" targetRef="Task_Invalid" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_FindTech" targetRef="Task_CheckPair" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckPair" targetRef="Gateway_PairAvailable" />
    <bpmn:sequenceFlow id="Flow_Available" name="Yes" sourceRef="Gateway_PairAvailable" targetRef="Task_Reserve" />
    <bpmn:sequenceFlow id="Flow_Unavailable" name="No" sourceRef="Gateway_PairAvailable" targetRef="Task_Unavailable" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Reserve" targetRef="Gateway_Reserved" />
    <bpmn:sequenceFlow id="Flow_Reserved" name="Yes" sourceRef="Gateway_Reserved" targetRef="Task_Persist" />
    <bpmn:sequenceFlow id="Flow_Conflict" name="No - concurrent conflict" sourceRef="Gateway_Reserved" targetRef="Task_Unavailable" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Persist" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Confirm" targetRef="End_Confirmed" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Invalid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Unavailable" targetRef="End_Unavailable" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Booking">
    <bpmndi:BPMNPlane id="Plane_Booking" bpmnElement="Process_Booking">
      <bpmndi:BPMNShape id="Shape_Valid" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="240" y="453" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="156.5" y="471" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_FindTech" bpmnElement="Task_FindTech">
        <dc:Bounds x="340" y="438" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckPair" bpmnElement="Task_CheckPair">
        <dc:Bounds x="550" y="438" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PairAvailable" bpmnElement="Gateway_PairAvailable" isMarkerVisible="true">
        <dc:Bounds x="780" y="453" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="415.5" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reserve" bpmnElement="Task_Reserve">
        <dc:Bounds x="880" y="438" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reserved" bpmnElement="Gateway_Reserved" isMarkerVisible="true">
        <dc:Bounds x="1080" y="453" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068" y="503" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Persist" bpmnElement="Task_Persist">
        <dc:Bounds x="1180" y="438" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Confirm" bpmnElement="Task_Confirm">
        <dc:Bounds x="1400" y="438" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndConfirmed" bpmnElement="End_Confirmed">
        <dc:Bounds x="1600" y="460" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1587" y="496" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Invalid" bpmnElement="Task_Invalid">
        <dc:Bounds x="180" y="630" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndInvalid" bpmnElement="End_Invalid">
        <dc:Bounds x="380" y="652" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="356" y="688" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Unavailable" bpmnElement="Task_Unavailable">
        <dc:Bounds x="852" y="630" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndUnavailable" bpmnElement="End_Unavailable">
        <dc:Bounds x="939" y="750" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="923" y="786" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_Request">
        <dc:Bounds x="247" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="234" y="84.5" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Submit" bpmnElement="Task_Submit">
        <dc:Bounds x="190" y="200" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Task_Validate">
        <dc:Bounds x="185" y="320" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow3" bpmnElement="Flow_3">
        <di:waypoint x="265" y="400" />
        <di:waypoint x="265" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FlowValid" bpmnElement="Flow_Valid">
        <di:waypoint x="290" y="478" />
        <di:waypoint x="340" y="478" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="306" y="453" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FlowInvalid" bpmnElement="Flow_Invalid">
        <di:waypoint x="265" y="503" />
        <di:waypoint x="265" y="630" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="273" y="557" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow4" bpmnElement="Flow_4">
        <di:waypoint x="510" y="478" />
        <di:waypoint x="550" y="478" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow5" bpmnElement="Flow_5">
        <di:waypoint x="740" y="478" />
        <di:waypoint x="780" y="478" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FlowAvailable" bpmnElement="Flow_Available">
        <di:waypoint x="830" y="478" />
        <di:waypoint x="880" y="478" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="846" y="453" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FlowUnavailable" bpmnElement="Flow_Unavailable">
        <di:waypoint x="805" y="503" />
        <di:waypoint x="805" y="670" />
        <di:waypoint x="852" y="670" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="813" y="577" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow6" bpmnElement="Flow_6">
        <di:waypoint x="1040" y="478" />
        <di:waypoint x="1080" y="478" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FlowReserved" bpmnElement="Flow_Reserved">
        <di:waypoint x="1130" y="478" />
        <di:waypoint x="1180" y="478" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1146" y="453" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FlowConflict" bpmnElement="Flow_Conflict">
        <di:waypoint x="1105" y="503" />
        <di:waypoint x="1105" y="670" />
        <di:waypoint x="1062" y="670" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="577" width="114" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow7" bpmnElement="Flow_7">
        <di:waypoint x="1360" y="478" />
        <di:waypoint x="1400" y="478" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow8" bpmnElement="Flow_8">
        <di:waypoint x="1550" y="478" />
        <di:waypoint x="1600" y="478" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow9" bpmnElement="Flow_9">
        <di:waypoint x="330" y="670" />
        <di:waypoint x="380" y="670" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow10" bpmnElement="Flow_10">
        <di:waypoint x="957" y="710" />
        <di:waypoint x="957" y="750" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow1" bpmnElement="Flow_1">
        <di:waypoint x="265" y="158" />
        <di:waypoint x="265" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow2" bpmnElement="Flow_2">
        <di:waypoint x="265" y="280" />
        <di:waypoint x="265" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
